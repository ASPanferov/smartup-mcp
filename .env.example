# Доступы к SmartUp. Скопируйте в .env и заполните — файл в git не попадает.
# Credentials for SmartUp. Copy to .env and fill in — the file is gitignored.

SMARTUP_LOGIN=
SMARTUP_PASSWORD=

# Филиал по умолчанию. Для записи обязателен: менять данные коннектор
# разрешит только в этом филиале.
# Default branch. Required for writing: the connector only accepts changes
# addressed to this branch.
SMARTUP_FILIAL_CODE=

# Режим записи. false — только чтение (по умолчанию).
# Write mode. false means read-only (the default).
SMARTUP_ALLOW_WRITE=false

SMARTUP_BASE_URL=https://smartup.online

# Сколько запросов к SmartUp коннектору разрешено за сутки.
# How many SmartUp requests the connector may spend per day.
SMARTUP_DAILY_BUDGET=60
